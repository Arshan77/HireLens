# HireLens Backend Environment Configuration (Phase 6 Production Ready)
APP_NAME=HireLens API
ENVIRONMENT=development
DEBUG=True
PORT=8001

# File Upload Settings
MAX_FILE_SIZE_BYTES=5242880

# CORS Allowed Origins (Comma-separated)
# In production, specify explicit domain(s), e.g., https://hirelens.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001

# Database Configuration
# Local SQLite fallback: sqlite:///./hirelens.db
# Production PostgreSQL: postgresql+psycopg://user:password@hostname:5432/hirelens_db
DATABASE_URL=sqlite:///./hirelens.db

# JWT Security Settings
# In production, must be set to a cryptographically secure random string (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
